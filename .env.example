# Copie este arquivo para .env.local e preencha com os seus valores.
# .env.local fica fora do git — nunca commite segredos.

# -----------------------------------------------------------------------------
# Segurança
# -----------------------------------------------------------------------------

# Segredo para assinar o cookie auth_token (HMAC-SHA256).
# Em produção, gere uma string aleatória longa (>= 32 chars).
# Em Linux/Mac:  openssl rand -hex 48
# Em Windows:    [System.Web.Security.Membership]::GeneratePassword(64,0)
AUTH_SECRET=troque-por-uma-string-longa-aleatoria-em-producao

# -----------------------------------------------------------------------------
# Admin bootstrap (só ativo até o primeiro admin real existir)
# -----------------------------------------------------------------------------

ADMIN_EMAIL=admin@test.com
ADMIN_PASSWORD=123456

# -----------------------------------------------------------------------------
# Asaas (PIX e cartão no Brasil)
# -----------------------------------------------------------------------------
# As API keys continuam em data/config.json, editáveis pelo painel.
# Aqui fica apenas o token enviado pelo Asaas como header para validar webhooks.
# Nunca commite data/config.json real; use data/config.sample.json como referencia segura.

ASAAS_WEBHOOK_TOKEN=

# -----------------------------------------------------------------------------
# Stripe
# -----------------------------------------------------------------------------
# Segredo usado para verificar a assinatura dos webhooks (`whsec_...`).

STRIPE_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# Mercado Pago
# -----------------------------------------------------------------------------
# Os Access Tokens (TEST-… e APP_USR-…) ficam em data/config.json,
# editáveis pelo painel /admin/configuracoes.
# Aqui só o segredo usado pra validar a assinatura dos webhooks.
# Gere em: https://www.mercadopago.com.br/developers/panel/app/<APP_ID>/webhooks

MERCADOPAGO_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# PagSeguro / PagBank
# -----------------------------------------------------------------------------
# Token de API fica em data/config.json (painel admin).
# Aqui só o segredo opcional para validar webhooks via header
# x-authenticity-token (HMAC-SHA256 do body cru).

PAGSEGURO_WEBHOOK_SECRET=

# -----------------------------------------------------------------------------
# E-mail (SMTP)
# -----------------------------------------------------------------------------
# Se não definido, o sistema funciona normalmente sem enviar e-mails.
# Use qualquer provedor SMTP: Gmail, Brevo, SendGrid, Mailgun, Resend, etc.
#
# Gmail de exemplo:
#   SMTP_HOST=smtp.gmail.com
#   SMTP_PORT=587
#   SMTP_SECURE=false
#   SMTP_USER=seuemail@gmail.com
#   SMTP_PASS=sua-senha-de-app  (gere em myaccount.google.com/apppasswords)
#   SMTP_FROM="Estúdio Foto <seuemail@gmail.com>"

SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# URL pública do site (usada nos links dos e-mails — sem barra no final)
NEXT_PUBLIC_SITE_URL=https://seusite.com.br

# -----------------------------------------------------------------------------
# Banco de dados (P38)
# -----------------------------------------------------------------------------
# Por padrão o backend é JSON (data/*.json). Para usar SQLite, rode
# `npm run db:migrate` que grava data/storage-backend.txt = "sqlite".
# Esta env var permite forçar o backend (sobrescreve o arquivo):
#   STORAGE_BACKEND=sqlite
#   STORAGE_BACKEND=json
STORAGE_BACKEND=

# -----------------------------------------------------------------------------
# Storage externo (P39)
# -----------------------------------------------------------------------------
# Configurado pelo painel /admin/configuracoes/storage. Estas envs são
# alternativas a configurar via UI e têm precedência (não implementado por
# padrão; o painel é a fonte canônica).

# -----------------------------------------------------------------------------
# Backup automático (P40)
# -----------------------------------------------------------------------------
# Onde salvar backups gerados por scripts/backup-daily.js
# (default: storage/backups/)
BACKUP_DIR=
# Quantos dias manter (default 30)
BACKUP_RETENTION_DAYS=30

# -----------------------------------------------------------------------------
# Monitoração (P40)
# -----------------------------------------------------------------------------
# Webhook (Slack/Discord/Telegram) para alertas críticos. Opcional.
MONITORING_WEBHOOK_URL=
# Espaço mínimo livre em GB antes de disparar alerta (default 10)
MONITORING_DISK_MIN_GB=10

# -----------------------------------------------------------------------------
# Opcionais
# -----------------------------------------------------------------------------

# Quando "true", os scripts de migração rodam mais verbose.
DEBUG_MIGRATIONS=false

# Limite de tamanho de upload (em MB) — default 200
NEXT_PUBLIC_MAX_UPLOAD_MB=200
