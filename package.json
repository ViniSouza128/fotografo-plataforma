{
  "name": "plataforma-fotografo",
  "version": "1.0.0",
  "description": "Plataforma de vendas de fotos - Vinícius Rodrigues",
  "private": true,
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "verify:full": "node scripts/verify-full.js",
    "verify:deep": "node scripts/verify-deep.js",
    "images:audit": "node scripts/normalize-image-variants.js",
    "images:normalize": "node scripts/normalize-image-variants.js --apply",
    "db:migrate": "node scripts/migrate-json-to-sqlite.js",
    "db:migrate:force": "node scripts/migrate-json-to-sqlite.js --force",
    "db:migrate:dry": "node scripts/migrate-json-to-sqlite.js --dry --force",
    "db:rollback": "node scripts/rollback-sqlite-to-json.js",
    "storage:migrate": "node scripts/migrate-storage-to-s3.js",
    "storage:migrate:originals": "node scripts/migrate-storage-to-s3.js --only-originals",
    "storage:migrate:derivatives": "node scripts/migrate-storage-to-s3.js --only-derivatives",
    "storage:rollback": "node scripts/rollback-storage-to-local.js",
    "backup": "node scripts/backup-daily.js",
    "monitor": "node scripts/monitor-health.js",
    "monitor:json": "node scripts/monitor-health.js --json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "start:prod": "next build && next start"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1045.0",
    "@aws-sdk/s3-request-presigner": "^3.1045.0",
    "better-sqlite3": "^12.9.0",
    "exifr": "^7.1.3",
    "ffmpeg-static": "^5.3.0",
    "next": "14.2.35",
    "nodemailer": "^8.0.7",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "sharp": "^0.33.4"
  },
  "devDependencies": {
    "eslint": "8.57.1",
    "eslint-config-next": "14.2.35",
    "jsdom": "^25.0.1",
    "playwright": "^1.59.1",
    "vitest": "3.2.4"
  },
  "optionalDependencies": {
    "@tensorflow/tfjs": "^4.22.0",
    "@vladmandic/face-api": "^1.7.15"
  }
}
